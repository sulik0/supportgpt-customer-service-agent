# SupportGPT 智能客服 Agent 环境变量配置

# API Server Config
APP_NAME=SupportGPT 智能客服 Agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Security and Auth
JWT_SECRET=super-secret-jwt-key-change-in-production-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 员工账号只允许管理员创建；生产环境强制为 false。
STAFF_SELF_REGISTRATION_ENABLED=false
# 生产必须仅填写已部署的前端 Origin，逗号分隔，禁止 *。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 仅在可信反向代理会覆盖 X-Forwarded-For 时开启。
TRUST_PROXY_HEADERS=false

# Public Demo isolation and abuse protection
PUBLIC_DEMO_ISOLATION_ENABLED=true
PUBLIC_DEMO_PROFILE_IDS=cust_101,cust_102,cust_103,cust_201,cust_202,cust_203
# 生产使用独立随机密钥：python scripts/generate_production_secrets.py
PUBLIC_VISITOR_SECRET=
PUBLIC_VISITOR_COOKIE_NAME=supportgpt_visitor
PUBLIC_VISITOR_COOKIE_MAX_AGE_SECONDS=2592000
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=5
PUBLIC_CHAT_RATE_LIMIT_PER_DAY=50
PUBLIC_READ_RATE_LIMIT_PER_MINUTE=30
PUBLIC_FEEDBACK_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_REDIS_PREFIX=supportgpt:rate-limit
MAX_REQUEST_BODY_BYTES=65536
# Tool Governance V2.2：生产必须使用独立 Fernet Key，不应与 JWT_SECRET 共用。
TOOL_POLICY_VERSION=tool-policy-v2.2
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOL_ACTION_ENCRYPTION_KEY=
# Worker 通过数据库租约并发消费 Transactional Outbox；Retry 耗尽后进入 DLQ。
TOOL_OUTBOX_WORKER_ENABLED=true
TOOL_OUTBOX_POLL_INTERVAL_SECONDS=1
TOOL_OUTBOX_BATCH_SIZE=20
TOOL_OUTBOX_LEASE_SECONDS=30
TOOL_OUTBOX_MAX_ATTEMPTS=5
TOOL_OUTBOX_RETRY_BASE_SECONDS=1
TOOL_OUTBOX_RETRY_MAX_SECONDS=60
TOOL_RECONCILIATION_DELAY_SECONDS=2

# Database & Cache
# 本地默认使用 SQLite；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite+aiosqlite:///./supportgpt.db
# Redis 为可选短期 Memory，未配置时自动回退 PostgreSQL / SQLite。
# REDIS_URL=redis://localhost:6379/0
# Memory V1：数据库保存结构化会话，Redis 只缓存有界上下文。
MEMORY_ENABLED=true
MEMORY_RECENT_MESSAGES=12
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_SUMMARY_MAX_CHARS=1200
MEMORY_SCAN_MESSAGES=48
MEMORY_TTL_SECONDS=86400

# LangGraph Durable Execution：本地独立 SQLite，PostgreSQL 环境默认复用 DATABASE_URL。
LANGGRAPH_CHECKPOINT_ENABLED=true
# 可选：显式指定 Checkpoint PostgreSQL/SQLite URL。
LANGGRAPH_CHECKPOINT_DATABASE_URL=
LANGGRAPH_CHECKPOINT_SQLITE_PATH=./.runtime/langgraph-checkpoints.sqlite
LANGGRAPH_CHECKPOINT_NAMESPACE=supportgpt-workflow-v1
LANGGRAPH_RESUME_LEASE_SECONDS=60

# LLM Providers (mock, openai, azure)
# openai 表示通用 OpenAI-compatible 协议，可连接 OpenAI、DeepSeek、Qwen、vLLM。
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-support-v1
LLM_BASE_URL=
LLM_API_KEY=
# 可选：Analyzer 和 QA 共用独立小模型服务，例如 Qwen Turbo。
LLM_FAST_MODEL_NAME=
LLM_FAST_BASE_URL=
LLM_FAST_API_KEY=
# 节点级模型名可覆盖 LLM_FAST_MODEL_NAME。
LLM_ANALYZER_MODEL_NAME=
LLM_QA_MODEL_NAME=
LLM_ANALYZER_MAX_TOKENS=120
LLM_RESOLVER_MAX_TOKENS=480
LLM_QA_MAX_TOKENS=96
LLM_RESOLVER_MAX_RAG_CHARS=5000
LLM_RESOLVER_MAX_TOOL_CHARS=2500
LLM_QA_MAX_CONTEXT_CHARS=4000
# DecisionProvider：默认关闭；启用 Jev 时需在服务端配置 API Key。
DECISION_PROVIDER=disabled
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=3
JEV_MAX_RETRIES=0
JEV_MAX_STATE_CHARS=12000
JEV_INTENT_CONFIDENCE_THRESHOLD=0.75
JEV_QA_CONFIDENCE_THRESHOLD=0.75
JEV_NOUL_THRESHOLD=0.7
# 可选备用 OpenAI-compatible 模型，三项需同时配置。
LLM_FALLBACK_MODEL_NAME=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# Resilience：仅瞬时故障有界重试，高风险/非幂等写操作禁止自动重试。
RESILIENCE_ENABLED=true
RESILIENCE_LLM_TIMEOUT_SECONDS=20
RESILIENCE_LLM_MAX_RETRIES=1
RESILIENCE_RAG_TIMEOUT_SECONDS=5
RESILIENCE_RAG_MAX_RETRIES=1
RESILIENCE_TOOL_READ_MAX_RETRIES=1
RESILIENCE_RETRY_BASE_DELAY_SECONDS=0.1
RESILIENCE_CIRCUIT_FAILURE_THRESHOLD=3
RESILIENCE_CIRCUIT_RECOVERY_SECONDS=30
PROMPT_VERSION=support-v1
PROMPT_REGISTRY_DIR=./.runtime/promptops
PROMPT_ENVIRONMENT=production
# 可选：固定内容 Hash。设置后覆盖环境指针，晋级/回滚需同步更新此配置。
PROMPT_BUNDLE_ID=
AGENT_WORKFLOW_VERSION=support-workflow-v1
# 真实 LLM 回归使用上述 Provider 配置，并必须通过 --confirm-live 显式确认。
# OPENAI_API_KEY 仅供 OpenAI Embedding 和离线 Evaluation 使用，可选。
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Vector DB
VECTOR_DB_PERSIST_DIR=./.runtime/chromadb-0.5
CHROMA_ANONYMIZED_TELEMETRY=false
# 仅连接独立 Chroma Server 时配置下列两项。
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Collector 可通过 OTLP 将 Trace 转发到 LangSmith；应用不直连 LangSmith SDK。
OTEL_COLLECTOR_LANGSMITH_API_KEY=your-langsmith-api-key-here
OTEL_COLLECTOR_LANGSMITH_PROJECT=supportgpt-enterprise
OTEL_COLLECTOR_LANGSMITH_ENDPOINT=https://api.smith.langchain.com/otel
# LangSmith 中展示脱敏后的 LLM 输入输出，超长内容自动截断。
LANGSMITH_CAPTURE_LLM_CONTENT=true
LANGSMITH_LLM_CONTENT_MAX_CHARS=50000

# OpenTelemetry (clear either endpoint to disable that network exporter)
# 本地保留 Trace ID 关联，未配置 endpoint 时不进行网络导出。
OTEL_ENABLED=true
OTEL_SERVICE_NAME=supportgpt-backend
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL_MILLISECONDS=15000
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=3
# 本地 Collector 不可达时跳过 exporter，避免后台重试日志刷屏。
OTEL_EXPORTER_PREFLIGHT_ENABLED=true
OTEL_EXPORTER_PREFLIGHT_TIMEOUT_SECONDS=0.25
OTEL_CONSOLE_EXPORTER=false
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_EXCLUDED_URLS=health

# Guardrails Settings
PII_ANONYMIZATION_ENABLED=true
PROMPT_INJECTION_PROTECTION_ENABLED=true
JAILBREAK_DETECTION_ENABLED=true
RESPONSE_FILTERING_ENABLED=true

# Qwen3Guard 语义安全分类（独立于业务 LLM，默认不启动外部服务）
QWEN3_GUARD_ENABLED=false
QWEN3_GUARD_BASE_URL=http://127.0.0.1:18001/v1
QWEN3_GUARD_API_KEY=EMPTY
QWEN3_GUARD_MODEL_NAME=Qwen/Qwen3Guard-Gen-0.6B
QWEN3_GUARD_TIMEOUT_SECONDS=5
QWEN3_GUARD_MAX_RETRIES=0
# false：Controversial 进入 Risk Engine 与人工审核；true：直接阻断。
QWEN3_GUARD_BLOCK_CONTROVERSIAL=false
QWEN3_GUARD_MAX_INPUT_CHARS=20000

# Risk Engine
RISK_MEDIUM_THRESHOLD=0.4
RISK_HIGH_THRESHOLD=0.7
RISK_CRITICAL_THRESHOLD=0.9
RISK_LOW_CONFIDENCE_THRESHOLD=0.65
RISK_QA_SCORE_THRESHOLD=0.8

# Feedback Pipeline
FEEDBACK_TRAINING_MIN_RATING=4
FEEDBACK_TRAINING_MIN_QA_SCORE=0.8
FEEDBACK_TRAINING_MIN_RAG_SCORE=0.75
