VITE_API_BASE_URL=http://localhost:8000
# 公开 Demo 可设为 false 隐藏员工入口，后端 RBAC 仍是实际安全边界。
VITE_STAFF_ENTRY_ENABLED=true
# 仅配置可公开的演示账号；VITE_ 变量会进入浏览器构建产物，不要使用真实员工凭据。
# JSON 示例（替换占位符后在本地 .env 中启用）：
# VITE_DEMO_ACCOUNTS='[{"label":"客服","username":"<演示用户名>","password":"<演示密码>"}]'
# 从 LangSmith Project 页面复制完整 URL，不要在前端放置 LangSmith API Key。
VITE_LANGSMITH_PROJECT_URL=https://smith.langchain.com/
